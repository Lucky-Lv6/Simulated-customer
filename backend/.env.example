# LLM 配置
LLM_API_KEY=你的LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# STT 配置（语音识别，默认使用 LLM 配置）
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-1

# TTS 配置（语音合成）
# 火山引擎语音合成服务 - 豆包语音合成模型2.0
# API Key 获取: https://console.volcengine.com/speech/new/setting/apikeys
# 价格: 3元/万字符
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=tts-1

# VAD 配置（语音活动检测）
VAD_SILENCE_DURATION_MS=400
VAD_MIN_SPEECH_DURATION_MS=200
VAD_MAX_SPEECH_DURATION_MS=30000

# 服务器配置
HOST=0.0.0.0
PORT=8765

# 超时配置（秒）
LLM_TIMEOUT_S=30
STT_TIMEOUT_S=20
TTS_TIMEOUT_S=30
CONVERSATION_TIMEOUT_S=300
